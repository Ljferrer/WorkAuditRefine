{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/validate-worktree-scope.sh" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/validate-servitor-provenance.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/validate-auditor-git.sh" },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/warn-bash-write-scope.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear|resume",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-campaign-state.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reply-standard/gate.sh\" card.py", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/reply-standard/gate.sh\" meter.py", "timeout": 10 }
        ]
      }
    ]
  }
}
