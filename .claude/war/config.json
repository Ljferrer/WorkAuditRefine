{
  "version": 1,
  "profile": "custom",
  "agents": {
    "worker": {
      "model": "opus",
      "effort": "default",
      "docs": {
        "model": "opus",
        "effort": "default"
      },
      "fix": {
        "model": "fable",
        "effort": "default"
      }
    },
    "auditor": {
      "model": "opus",
      "effort": "default"
    },
    "refiner": {
      "model": "sonnet",
      "effort": "high",
      "recovery": {
        "model": "fable",
        "effort": "default"
      }
    },
    "servitor": {
      "model": "opus",
      "effort": "high"
    },
    "redteam": {
      "model": "opus",
      "effort": "default"
    },
    "snipe": {
      "model": "opus",
      "effort": "default"
    },
    "trial": {
      "model": "opus",
      "effort": "default"
    }
  },
  "audit": {
    "roster": [
      {
        "lens": "correctness",
        "depth": "deep"
      },
      {
        "lens": "cascading-impact",
        "depth": "deep"
      },
      {
        "lens": "performance",
        "depth": "deep"
      },
      {
        "lens": "simplicity",
        "depth": "deep"
      },
      {
        "lens": "security",
        "depth": "deep"
      }
    ],
    "rosterPolicy": "auto",
    "autoEscalate": true
  },
  "run": {
    "roundLimit": 6,
    "absorbRounds": 6,
    "redteamRoundLimit": 3,
    "afk": false,
    "ace": true,
    "provision": [],
    "provisionSource": "structural",
    "provisionAuto": true
  },
  "memory": {
    "retrieval": true,
    "topK": 10,
    "commitLearnings": true
  },
  "hooks": {
    "replyStandard": true,
    "valeMarkdown": true,
    "valeStyle": "workAuditRefine"
  },
  "interview": {
    "trialWallSeconds": 600,
    "commandTimeoutSeconds": 120,
    "excerptLines": 20
  },
  "overrides": {
    "gate": "node --test 'skills/**/*.test.mjs'",
    "workingBranch": null,
    "landingBranch": null,
    "learningsTarget": null,
    "testPattern": null,
    "ghUser": "Ljferrer"
  }
}
